NODE_ENV=development
PORT=8787
HOST=127.0.0.1

# Choose openai for API billing, or codex for an always-on Mac that is signed in
# to Codex through a ChatGPT plan. Keep every setting server-side.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=24000

# Used only when AI_PROVIDER=codex. The macOS installer fills the absolute paths.
# Codex plan limits still apply; this is not an unlimited API entitlement.
CODEX_COMMAND=codex
CODEX_MODEL=gpt-5.6-sol
CODEX_TIMEOUT_MS=900000
CODEX_WORKDIR=.

# Optional absolute Chrome/Chromium path. The macOS installer selects installed
# Google Chrome automatically, including on macOS 13 where Playwright no longer
# distributes a compatible bundled Chromium.
BROWSER_EXECUTABLE_PATH=

# Local development uses SQLite. Production must set DATABASE_URL to PostgreSQL.
SQLITE_PATH=./data/agent-memory.sqlite
DATABASE_URL=
DATABASE_SSL=true
# Instead of DATABASE_URL, production can use the separate settings below.
# This is safer when DB_PASSWORD contains characters that need URL encoding.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=
# DB_PASSWORD=

# Local development can use a long static token.
AUTH_MODE=token
AGENT_API_TOKENS=default-company=replace-with-at-least-32-random-characters
# Production should use short-lived OIDC/JWT identity instead. Configure these on
# the server and set window.AGENT_EXECUTOR_CONFIG.getAccessToken in the app.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://identity.example.com/
# OIDC_AUDIENCE=website-agent
# OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# OIDC_ALGORITHMS=RS256
# OIDC_FIXED_ORGANIZATION_ID=default-company
# OIDC_ORGANIZATION_CLAIM=organization_id
# OIDC_REQUIRED_SCOPE=website-agent
# OIDC_CLOCK_TOLERANCE_SECONDS=5
# ALLOW_STATIC_TOKEN_AUTH=false
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://managing.masaratkobra.com

WORKER_ID=local-worker-1
WORKER_CONCURRENCY=2
WORKER_HEARTBEAT_MS=30000
JOB_POLL_MS=1000
JOB_LEASE_MS=120000
JOB_MAX_ATTEMPTS=3
OPENAI_TIMEOUT_MS=90000
BROWSER_TIMEOUT_MS=30000
MAX_AUDIT_PAGES=4
MAX_SKILL_PAGES=250
MAX_NETWORK_HOSTS=40
MAX_SCREENSHOT_BYTES=3500000
